{
  "name": "roteador-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "outdated": "pnpm outdated -r",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "prettier": "^3.10.0",
    "tsdown": "^0.23.7",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "@changesets/cli": "^2.29.7",
    "@changesets/changelog-github": "^0.5.1"
  }
}
